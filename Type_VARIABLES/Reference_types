using System;

class Program{
    static void Main(){
        string name = "ABC";
        Console.WriteLine("Name: " + name);

        object data = 100;
        Console.WriteLine("Object: " + data);

        int[] marks = { 80, 90, 85 };

        Console.WriteLine("First Mark: " + marks[0]);
        Console.WriteLine("Second Mark: " + marks[1]);
        Console.WriteLine("Third Mark: " + marks[2]);

        int a = 10;
        int b = a;

        b = 20;

        Console.WriteLine("Value Type a: " + a);
        Console.WriteLine("Value Type b: " + b);

        int[] x = { 10, 20, 30 };
        int[] y = x;

        y[0] = 100;

        Console.WriteLine("Reference Type x[0]: " + x[0]);
        Console.WriteLine("Reference Type y[0]: " + y[0]);
    }
}
