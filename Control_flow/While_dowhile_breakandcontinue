using System;

class Program{
    static void Main(){
        int i = 1;

        while (i <= 5){
            Console.WriteLine(i);
            i++;
        }
    }
}





using System;

class Program{
    static void Main(){
        int i = 10;

        do{
            Console.WriteLine(i);
            i++;
        }
        while (i <= 5);
    }
}





using System;

class Program{
    static void Main(){
        for (int i = 1; i <= 10; i++){
            if (i == 5){
                break;
            }

            Console.WriteLine(i);
        }
    }
}







using System;

class Program{
    static void Main(){
        for (int i = 1; i <= 5; i++){
            if (i == 3){
                continue;
            }

            Console.WriteLine(i);
        }
    }
}
